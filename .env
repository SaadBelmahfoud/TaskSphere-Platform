# ═══════════════════════════════════════════════════════
# VARIABLES D'ENVIRONNEMENT — TaskSphere Platform
# ═══════════════════════════════════════════════════════
#
# UTILISATION :
# Option 1 : Charger dans le shell avant de lancer l'appli
#   source .env && mvn spring-boot:run
#
# Option 2 : Exporter une par une
#   export JWT_SECRET=votre-cle-secrete-256-bits
#   export INIT_USER_PASSWORD=password123
#   mvn spring-boot:run
#
# Option 3 : Passer directement à Maven
#   JWT_SECRET=cle-secret mvn spring-boot:run
# ═══════════════════════════════════════════════════════

# Clé secrète JWT (minimum 32 caractères / 256 bits pour HS256)
# EN PRODUCTION : utiliser une clé aléatoire complexe, JAMAIS celle-ci
export JWT_SECRET=tasksphere-dev-secret-key-change-me-in-production-256bits

# Mot de passe des utilisateurs de test (saadoune, manager, admin)
# Par défaut : password123
export INIT_USER_PASSWORD=password123
