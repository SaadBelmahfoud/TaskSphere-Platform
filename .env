# ═══════════════════════════════════════════════════════════════════
# ENVIRONNEMENT DE DÉVELOPPEMENT LOCAL (H2 en mémoire)
# ═══════════════════════════════════════════════════════════════════
# Ce fichier est lu par docker-compose ET par Spring Boot (via IDE).
# Il NE DOIT PAS être commité dans Git (déjà dans .gitignore).
#
# UTILISATION :
#   - En mode dev (sans Docker) : l'IDE lit ces variables
#   - En mode dev (avec Docker) : docker compose lit ce fichier
#
# ⚠️ REMPLACER les valeurs ci-dessous par des secrets robustes !

# ═══════════════════════════════════════════
# JWT — Clé secrète pour la signature des tokens
# ═══════════════════════════════════════════
# OBLIGATOIRE. Min 256 bits (32 caractères).
# En dev, on peut utiliser une clé simple, mais elle doit être unique.
# ⚠️ NE JAMAIS utiliser cette clé en production !
JWT_SECRET=dev-local-secret-key-for-tasksphere-minimum-256bits-long

# ═══════════════════════════════════════════
# Mot de passe des utilisateurs de test
# ═══════════════════════════════════════════
# OBLIGATOIRE. Utilisé par DataInitializer pour créer :
#   - saadoune (USER)
#   - manager (MANAGER)
#   - admin (ADMIN)
# En dev, un mot de passe simple est acceptable (base H2 temporaire).
# ⚠️ En production, utiliser un mot de passe fort (min 12 car., mix maj/min/chiffres/special)
INIT_USER_PASSWORD=DevTest123!

# ═══════════════════════════════════════════
# Base de données PostgreSQL (pour Docker Compose)
# ═══════════════════════════════════════════
# Ces variables sont utilisées par docker-compose.yml.
# En mode dev sans Docker (H2), elles ne sont pas lues par Spring Boot.
DB_NAME=taskspheredb
DB_USERNAME=tasksphere
DB_PASSWORD=tasksphere123
DB_PORT=5432
# DB_HOST : nom du service Docker (postgres) ou localhost
DB_HOST=localhost
DB_SSL_MODE=disable

# ═══════════════════════════════════════════
# Backend Spring Boot
# ═══════════════════════════════════════════
BACKEND_PORT=8080

# ═══════════════════════════════════════════
# Frontend Next.js
# ═══════════════════════════════════════════
FRONTEND_PORT=3000

# ═══════════════════════════════════════════
# CORS — Origines autorisées
# ═══════════════════════════════════════════
# Séparer par des virgules pour plusieurs origines.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ═══════════════════════════════════════════
# SSL / HTTPS
# ═══════════════════════════════════════════
# En dev : SSL désactivé (HTTP localhost)
SSL_ENABLED=false
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=
SSL_KEY_ALIAS=tasksphere

# ═══════════════════════════════════════════
# Cookies HttpOnly (P1-5)
# ═══════════════════════════════════════════
# En dev : secure=false car HTTP localhost
# (défini dans application.yaml, PAS besoin de le surcharger ici)
APP_COOKIE_SECURE=false