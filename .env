# ═══════════════════════════════════════════════════════════════════
# VARIABLES D'ENVIRONNEMENT DOCKER COMPOSE
# ═══════════════════════════════════════════════════════════════════
# Ce fichier est lu par docker-compose pour définir les variables.
# Il NE DOIT PAS être commité dans Git (ajoutez-le à .gitignore).
# En production, utilisez les secrets Docker ou un vault.

# ═══════════════════════════════════════════
# Base de données PostgreSQL
# ═══════════════════════════════════════════
DB_NAME=taskspheredb
DB_USERNAME=tasksphere
DB_PASSWORD=tasksphere123
DB_PORT=5432
# DB_HOST est géré par docker-compose (nom du service "postgres")
# Ne pas changer sauf si PostgreSQL tourne hors de Docker
DB_SSL_MODE=disable

# ═══════════════════════════════════════════
# Backend Spring Boot
# ═══════════════════════════════════════════
BACKEND_PORT=8080
# ⚠️ OBLIGATOIRE : Changer en production ! Min 256 bits.
JWT_SECRET=tasksphere-prod-secret-key-change-me-in-production-256bits
INIT_USER_PASSWORD=password123

# ═══════════════════════════════════════════
# Frontend Next.js
# ═══════════════════════════════════════════
FRONTEND_PORT=3000

# ═══════════════════════════════════════════
# SPRINT 5 : CORS — Origines autorisées
# ═══════════════════════════════════════════
# Séparer par des virgules pour plusieurs origines.
# Dev : http://localhost:3000
# Prod : https://tasksphere.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ═══════════════════════════════════════════
# SPRINT 5 : SSL / HTTPS
# ═══════════════════════════════════════════
# SSL_ENABLED=true active le HTTPS dans Spring Boot directement.
# En général, on préfère utiliser Nginx comme reverse proxy pour le SSL.
SSL_ENABLED=false
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=
SSL_KEY_ALIAS=tasksphere