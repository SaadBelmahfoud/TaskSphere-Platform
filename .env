# ═══════════════════════════════════════════════════════════════════
# VARIABLES D'ENVIRONNEMENT DOCKER COMPOSE
# ═══════════════════════════════════════════════════════════════════
# Ce fichier est lu par docker-compose pour définir les variables.
# Il NE DOIT PAS être commité dans Git (ajoutez-le à .gitignore).
# En production, utilisez les secrets Docker ou un vault.

# Base de données
DB_NAME=taskspheredb
DB_USERNAME=tasksphere
DB_PASSWORD=tasksphere123
DB_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_SECRET=tasksphere-prod-secret-key-change-me-in-production-256bits
INIT_USER_PASSWORD=password123

# Frontend
FRONTEND_PORT=3000