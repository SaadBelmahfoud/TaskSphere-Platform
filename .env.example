# ═══════════════════════════════════════════════════════════════════
# EXEMPLE DE CONFIGURATION — Copier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════════
# cp .env.example .env
# Puis remplacer les valeurs ci-dessous

# JWT — Obligatoire. Min 32 caractères. Générer : openssl rand -base64 48
JWT_SECRET=

# Mot de passe utilisateurs initiaux (saadoune, manager, admin)
INIT_USER_PASSWORD=

# PostgreSQL (docker-compose uniquement)
DB_NAME=taskspheredb
DB_USERNAME=tasksphere
DB_PASSWORD=
DB_PORT=5432
DB_HOST=localhost
DB_SSL_MODE=disable

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookies
APP_COOKIE_SECURE=false